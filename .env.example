# IIT DevOps
# Example environment configuration.
# Duplicate this file as `.env` and update the values to match your environment.
# Do not commit the `.env` file to source control; it may contain sensitive information.
# Note: `APP_PORT` is used by the Dockerfile to set the exposed port.
#
# IMPORTANT: 
# - For local development (using existing PostgreSQL on port 5432), use 'localhost' as the hostname.
# - For Docker Compose, use port 5433 (to avoid conflict with existing PostgreSQL) and 'db' as the hostname.

APP_PORT=3000
NODE_ENV=development

DB_PORT=5433
DB_HOST=localhost
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}
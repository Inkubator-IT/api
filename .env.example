# IIT DevOps
# Example environment configuration.
# Duplicate this file as `.env` and update the values to match your environment.
# Do not commit the `.env` file to source control; it may contain sensitive information.
# Note: `APP_PORT` is used by the Dockerfile to set the exposed port.
#
# IMPORTANT: 
# - For local development (using existing PostgreSQL on port 5432), use 'localhost' as the hostname.
# - For Docker Compose, use port 5433 (to avoid conflict with existing PostgreSQL) and 'db' as the hostname.

APP_PORT=9000
NODE_ENV=development
DATABASE_URL=postgresql://myuser:mypassword@localhost:5433/mydb

# S3 Storage Configuration
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=your_bucket_name
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
# Public HTTPS domain (S3 website endpoint, CDN, etc.)
S3_PUBLIC_BASE_URL=https://cdn.example.com/your_bucket_name